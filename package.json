{
  "name": "schematic-converter",
  "version": "1.0.1",
  "private": true,
  "description": "Convert modern Minecraft schematics (.schem, .litematic, .nbt) to 1.8.8 .schematic files, including very large maps.",
  "homepage": "https://github.com/okiwiziin/schematic-converter",
  "bugs": {
    "url": "https://github.com/okiwiziin/schematic-converter/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/okiwiziin/schematic-converter.git"
  },
  "license": "MIT",
  "author": "okiwiziin",
  "main": "out/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "dev": "electron-vite dev",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "format": "ultracite fix",
    "generate-data": "node scripts/generate-data.mjs",
    "icons": "node scripts/make-icons.mjs",
    "lint": "ultracite check",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:e2e": "electron-vite build && node test/e2e/app.e2e.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.65.0",
    "minecraft-data": "^3.119.0",
    "playwright": "^1.64.1",
    "prismarine-nbt": "^2.8.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "ultracite": "^8.1.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "io.github.okiwiziin.schematicconverter",
    "productName": "Schematic Converter",
    "copyright": "Copyright (c) 2026 okiwiziin",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "out/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Schematic-Converter-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Schematic-Converter-${version}-Portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "okiwiziin",
        "repo": "schematic-converter"
      }
    ]
  },
  "productName": "Schematic Converter"
}
